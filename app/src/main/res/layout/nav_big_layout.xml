<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/nav_layout"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="19dp"
        android:paddingVertical="12dp"
        android:background="#2E2F30"
        >
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/mediaView"
            android:layout_width="match_parent"
            android:layout_height="154dp"
            android:layout_margin="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottom_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/mediaView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/ad_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="6dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/ad_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:text="AD"
                android:textSize="10sp"
                android:background="#FBBC06"
                android:paddingHorizontal="6dp"
                android:layout_marginHorizontal="5dp"
                app:layout_constraintStart_toEndOf="@id/ad_icon"
                app:layout_constraintTop_toBottomOf="@id/ad_title"
                app:layout_constraintBottom_toBottomOf="@id/ad_icon"
                />


            <TextView
                android:id="@+id/ad_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                tools:text="Text app name main titleText app name main titleText app name main title Text app name main titleText app name main titleText app name main title"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:ellipsize="end"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/ad_icon"
                app:layout_constraintStart_toEndOf="@id/ad_icon"/>

            <TextView
                android:id="@+id/ad_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/white"
                android:maxLines="2"
                android:layout_marginHorizontal="5dp"
                tools:text="Next text little sample Sample text .....Next text little sample balabalabala balabalab Sample text .....Next text little sample balabalabala balabalab Sample text ....."
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ad_tag"
                app:layout_constraintTop_toBottomOf="@id/ad_title"
                app:layout_constraintBottom_toBottomOf="@id/ad_icon" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/ad_call"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_install"
            tools:text="INSTALL"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="7dp"
            android:layout_marginHorizontal="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bottom_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.95"/>


    </androidx.constraintlayout.widget.ConstraintLayout>



</com.google.android.gms.ads.nativead.NativeAdView>