<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/nav_layout"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            app:cardCornerRadius="4dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginHorizontal="10dp"
            app:layout_constraintDimensionRatio="2.561"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/media_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.cardview.widget.CardView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottom_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/card_view"
            app:layout_constraintStart_toStartOf="@id/card_view"
            app:layout_constraintEnd_toEndOf="@id/card_view">

            <androidx.cardview.widget.CardView
                android:id="@+id/ad_icon_layout"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="#FFD9D9D9"
                android:layout_margin="6dp"
                app:cardCornerRadius="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <ImageView
                    android:id="@+id/ad_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/ad_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:text="AD"
                android:textSize="10sp"
                android:background="#FBBC06"
                android:paddingHorizontal="6dp"
                android:layout_marginHorizontal="5dp"
                app:layout_constraintStart_toEndOf="@id/ad_icon_layout"
                app:layout_constraintTop_toBottomOf="@id/ad_title"
                app:layout_constraintBottom_toBottomOf="@id/ad_icon_layout"
                />


            <TextView
                android:id="@+id/ad_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                tools:text="Text app name main titleText app name main titleText app name main title Text app name main titleText app name main titleText app name main title"
                android:textColor="#FF333333"
                android:textSize="12sp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:ellipsize="end"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/ad_icon_layout"
                app:layout_constraintStart_toEndOf="@id/ad_icon_layout"/>

            <TextView
                android:id="@+id/ad_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#99000000"
                android:maxLines="2"
                android:layout_marginHorizontal="5dp"
                tools:text="Next text little sample balabalabala balabalab Sample text .....Next text little sample balabalabala balabalab Sample text .....Next text little sample balabalabala balabalab Sample text ....."
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ad_tag"
                app:layout_constraintTop_toBottomOf="@id/ad_title"
                app:layout_constraintBottom_toBottomOf="@id/ad_icon_layout" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <Button
            android:id="@+id/ad_call"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            tools:text="INSTALL"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:gravity="center"
            android:background="#568AF4"
            android:layout_marginBottom="7dp"
            android:layout_marginHorizontal="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bottom_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.95" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.gms.ads.nativead.NativeAdView>